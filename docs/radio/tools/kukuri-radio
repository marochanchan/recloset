def normalize_pronunciation(text: str) -> str:
    for wrong, correct in PRONUNCIATION_MAP.items():
        text = text.replace(wrong, correct)
    return text


SILENCE_NORMAL  = 0.4
SILENCE_CHAPTER = 0.8

PRODUCTIONS_DIR = None
AUDIO_DIR = None

_FORCE_STRIP_INNER: frozenset[str] = frozenset({"笑", "笑い", "苦笑", "照笑"})

